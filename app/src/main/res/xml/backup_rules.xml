<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto-Backup rules file (devices older than API 31).
    Excludes local database containing sensitive student records from cloud auto-backup.
-->
<full-backup-content>
    <!-- Exclude database containing sensitive personal student income and profile records from cloud backup -->
    <exclude domain="database" path="student_help_hub.db"/>
    <exclude domain="database" path="student_help_hub.db-wal"/>
    <exclude domain="database" path="student_help_hub.db-shm"/>
    <exclude domain="database" path="student_help_hub.db-journal"/>
    <include domain="sharedpref" path="."/>
</full-backup-content>
